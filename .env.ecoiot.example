# EcoIoT Forgejo Configuration
# Copy this to .env and fill in your values

# Forgejo Registry Configuration  
FORGEJO_REGISTRY=git.ecoiot.co.nz
FORGEJO_DOMAIN=forgejo.ecoiot.co.nz
FORGEJO_ORG=YOUR_USERNAME
IMAGE_NAME=lesetool-directus
VERSION=latest

# Database Configuration
DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=your_secure_db_password

# Security (GENERATE NEW VALUES!)
KEY=your-32-character-encryption-key-here
SECRET=your-32-character-jwt-secret-here

# Admin User
ADMIN_EMAIL=admin@ecoiot.co.nz
ADMIN_PASSWORD=your_secure_admin_password

# Network
PUBLIC_URL=https://forgejo.ecoiot.co.nz
DIRECTUS_PORT=8055
LOG_LEVEL=warn

# Forgejo Authentication (for CI/CD)
FORGEJO_USER=YOUR_USERNAME
FORGEJO_TOKEN=775f9a5af8ad5b515714361489e1a032a24232df