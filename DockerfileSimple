# Simple Dockerfile - uses pre-built extensions
FROM directus/directus:11.9.2

# Switch to root to copy files
USER root

# Copy pre-built extensions (build them locally first with ./scripts/build-extensions.sh)
COPY extensions/endpoint-energy-summary/dist /directus/extensions/endpoint-energy-summary
COPY extensions/endpoint-sql-view/dist /directus/extensions/endpoint-sql-view
COPY extensions/endpoint-run-battery-sim/dist /directus/extensions/endpoint-run-battery-sim
COPY extensions/panel-energy-summary/dist /directus/extensions/panel-energy-summary
COPY extensions/panel-sql-view/dist /directus/extensions/panel-sql-view
COPY extensions/panel-run-battery-sim/dist /directus/extensions/panel-run-battery-sim
COPY extensions/panel-open-link/dist /directus/extensions/panel-open-link
COPY extensions/interface-dropdown/dist /directus/extensions/interface-dropdown
COPY extensions/panel-scenario-columns/dist /directus/extensions/panel-scenario-columns

# Copy database schema files
#COPY tables_up.sql /docker-entrypoint-initdb.d/01-schema.sql
#COPY materialized_view.sql /docker-entrypoint-initdb.d/02-views.sql
#COPY summary.sql /docker-entrypoint-initdb.d/03-summary.sql

# Copy uploads directory if needed
COPY uploads/ /directus/uploads/

# Set proper permissions
RUN chown -R node:node /directus/extensions /directus/uploads

# Switch back to node user
USER node
