# Forgejo Container Registry Environment Variables
# Copy this to .env and fill in your values

# Forgejo Registry Configuration
FORGEJO_REGISTRY=forgejo.yourcompany.com
FORGEJO_ORG=your-organization
IMAGE_NAME=lesetool-directus
VERSION=latest

# Database Configuration
DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=your_secure_db_password

# Security (GENERATE NEW VALUES!)
KEY=your-32-character-encryption-key-here
SECRET=your-32-character-jwt-secret-here

# Admin User
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=your_secure_admin_password

# Network
PUBLIC_URL=https://your-domain.com
DIRECTUS_PORT=8055
LOG_LEVEL=warn

# Forgejo Authentication (for CI/CD)
FORGEJO_USER=your-username
FORGEJO_TOKEN=your-personal-access-token

# SSL/TLS (if using reverse proxy)
# HTTPS=true
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
